/*
 * system-user.dtsi -- VCK190 memory-loopback: device-tree additions.
 *
 * Copied into the PetaLinux project by `make vck190-import-xsa`.  The
 * generated device tree (pl.dtsi, from the XSA) already describes axi_dma
 * and the two receiver register blocks; this file only changes how Linux
 * binds them:
 *
 *   rx ctrl / rx demod  -> generic-uio, so a userspace tool can mmap the
 *                          receiver's registers (the same maps the sim
 *                          runner writes: OUTPUT_SHIFT, NORM_SQUELCH, the
 *                          timing and carrier gains, the readbacks).
 *   axi_dma             -> stays on the kernel xilinx_dma driver; a dma-proxy
 *                          node gives userspace one MM2S and one S2MM channel
 *                          (module recipe: recipes-modules/dma-proxy; 4 MB
 *                          buffers x 32 x 2 channels = 256 MB of coherent
 *                          memory, hence cma=512M in bootargs).
 *
 * The node labels (rx, axi_dma) are the device-tree generator's, read from
 * pl.dtsi after the first import (2026-10-24): the receiver is ONE node,
 * "rx: haifuraiya_rx_axi@a4010000", with two reg entries (0xa4010000 and
 * 0xa4020000), so generic-uio gives /dev/uio0 with map0 = channelizer
 * registers and map1 = demod registers.
 */
/include/ "system-conf.dtsi"
/ {
	chosen {
		bootargs = "console=ttyAMA0 earlycon=pl011,mmio32,0xFF000000,115200n8 clk_ignore_unused root=/dev/ram0 rw uio_pdrv_genirq.of_id=generic-uio cma=512M";
	};

	dma_proxy {
		compatible = "xlnx,dma_proxy";
		dmas = <&axi_dma 0 &axi_dma 1>;
		dma-names = "dma_proxy_tx", "dma_proxy_rx";
	};
};

/* receiver registers as a UIO device: /dev/uio0, map0 = channelizer ctrl
 * (0xA4010000), map1 = demod (0xA4020000) */
&rx {
	compatible = "generic-uio";
};

/* tier 2 only: the ESIstream link block (esi_link_hw, 0xA4030000) as
 * /dev/uio1, map0 -- opv_play reads its status and counters there.  The
 * label is the device-tree generator's for the block-design cell
 * playback_i/esi_link/esi; CONFIRM it in the generated pl.dtsi after
 * `make vck190-import-xsa` (grep -n a4030000 ... pl.dtsi) before
 * `make vck190-build`, and change it here if it differs.  A tier-1 import
 * has no such node, and this reference would then fail the device-tree
 * build: comment it out for a tier-1 image. */
&esi_link_esi {
	compatible = "generic-uio";
};

/* The GTY reference clock for tier 2 and tier 3: the board's user SI570
 * (U205) on PMC I2C0 (i2c2, f1000000) behind TCA9548A switch U33, channel
 * 6, address 0x5F (UG1366, "PMC MIO 46-47 I2C0 Bus"; the System Controller's
 * VCK190.json calls it SI570_USER1_FMC, default 100 MHz).  The kernel's
 * clk-si570 driver programs clock-frequency at every boot, so the clock is
 * part of the image: nothing to do after a power cycle, no System
 * Controller involved.  U33's address is 0x74 in UG1366's text and 0x75 in
 * its table -- confirm with `i2cdetect -y -r 2` on the board (i2c-tools is
 * in the rootfs for this) and change it here if the switch answers at 0x75.
 * temperature-stability 50 ppm and factory-fout 100 MHz are the driver's
 * required inputs: 50 is the conservative grade (10-945 MHz range), 100 MHz
 * is the documented power-up frequency; both assumed, not measured. */
&i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	i2c-mux@74 {
		compatible = "nxp,pca9548";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x74>;
		i2c@6 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <6>;
			si570_user1: clock-generator@5f {
				#clock-cells = <0>;
				compatible = "silabs,si570";
				reg = <0x5f>;
				temperature-stability = <50>;
				factory-fout = <100000000>;
				clock-frequency = <156250000>;
				clock-output-names = "si570_user1";
			};
		};
	};
};
